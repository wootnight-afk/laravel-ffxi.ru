# ------------------------------------------------------------------
# Example environment file. Committed to Git WITHOUT real secrets.
# Values below match the local Docker Compose stack (spec section 4).
# Production values are set in .env on the server and never committed.
# ------------------------------------------------------------------

APP_NAME=FFXI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Target timezone; production must use the same value (spec section 4).
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MySQL 8.4 service of docker-compose (spec section 5).
# Production values come from the Timeweb panel (spec section 7).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_ffxi
DB_USERNAME=laravel
DB_PASSWORD=secret

# Runtime drivers are locked by spec section 6: file/database only.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# Local SMTP is Mailpit from docker-compose; production SMTP
# credentials are set in the production .env only (spec section 13).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ffxi.ru"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
